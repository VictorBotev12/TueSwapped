  m_Script: {fileID: 11500000, guid: faf1cf00302389b418be9982dd6ec22c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueLines:
  - characterName: "\u041F\u0430\u043D\u0430\u0434\u043E\u043B \u041D\u0435\u043C\u0441\u043A\u0438"
    dialogueText: "\u0417\u0434\u0440\u0430\u0432\u0435\u0439\u0442\u0435, \u0443\u0447\u0435\u043D\u0438\u0446\u0438! "
    characterSprite: {fileID: 7074738417439361500, guid: d244efe955255844f8c38b6509f9ff69, type: 3}
  - characterName: "\u041F\u0430\u043D\u0430\u0434\u043E\u043B \u041D\u0435\u043C\u0441\u043A\u0438"
    dialogueText: "\u0414\u043D\u0435\u0441 \u0449\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043C \u0437\u0430 \u043A\u043E\u043B\u043A\u043E \u043E\u0431\u043E\u0436\u0430\u0432\u0430\u043C \u0430\u043D\u0433\u043B\u043E-\u0441\u0430\u043A\u0441\u043E\u043D\u0446\u0438\u0442\u0435. "
    characterSprite: {fileID: 7074738417439361500, guid: d244efe955255844f8c38b6509f9ff69, type: 3}
  - characterName: "\u041F\u0430\u043D\u0430\u0434\u043E\u043B \u041D\u0435\u043C\u0441\u043A\u0438"
    dialogueText: "\u0422\u0435 \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u044F\u0442 \u0440\u0430\u0432\u0435\u043D\u0441\u0442\u0432\u043E\u0442\u043E, \u043A\u0430\u043A\u0442\u043E \u0438 \u0442\u0440\u044F\u0431\u0432\u0430. "
    characterSprite: {fileID: 7074738417439361500, guid: d244efe955255844f8c38b6509f9ff69, type: 3}
  - characterName: "\u041F\u0430\u043D\u0430\u0434\u043E\u043B \u041D\u0435\u043C\u0441\u043A\u0438"
    dialogueText: "\u0410 \u0442\u0443\u043A \u0432 \u0411\u044A\u043B\u0433\u0430\u0440\u0438\u044F - \u043F\u044A\u043B\u043D\u043E \u0441 \u0431\u0430\u0439\u0433\u0430\u043D\u044C\u043E\u0432\u0446\u0438, \u043A\u043E\u0438\u0442\u043E \u0441\u0435 \u043F\u043E\u0431\u044A\u0440\u043A\u0432\u0430\u0442 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u0432 \u043A\u043E\u0439\u0442\u043E \u0432\u0438\u0434\u044F\u0442 \u043D\u044F\u043A\u043E\u0439 \u043F\u043E-\u0440\u0430\u0437\u043B\u0438\u0447\u0435\u043D \u043E\u0442 \u0442\u044F\u0445. "
    characterSprite: {fileID: 7074738417439361500, guid: d244efe955255844f8c38b6509f9ff69, type: 3}
  - characterName: "\u0427\u0430\u0432\u0434\u0430\u0440 \u0412\u043E\u0439\u0432\u043E\u0434\u0430"
    dialogueText: "\u0411\u0438\u0445 \u0443\u043C\u0440\u044F\u043B \u0437\u0430 \u043D\u0430\u0448\u0430\u0442\u0430 \u0440\u043E\u0434\u0438\u043D\u0430!!! "
    characterSprite: {fileID: -3174131253947086912, guid: b117fbf764f13614ab29542b85ac863b, type: 3}
  nameText: {fileID: 954666076}
  dialogueText: {fileID: 319085685}
  characterSprite: {fileID: 757247185}
  nextButton: {fileID: 328521140}
